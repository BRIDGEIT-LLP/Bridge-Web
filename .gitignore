# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.md
*.html

# Claude PR-review reports (scripts/pr-analysis) stay local — the review
# itself is posted to the PR as a comment.
.claude-reports/

# Deal Room — real feature is now tracked. Only the walkthrough /demo route stays
# ignored (its dummy data + in-memory store live under demo/ and the store/dummy files).
src/app/dashboard/deal-room/demo/

# Connections DEMO — walkthrough-only /demo route (its dummy data is inlined in the
# route's page.tsx). The real connections feature (page.tsx, screen/list/drawer, lib,
# service) stays tracked; only this demo-only path is ignored.
src/app/dashboard/connections/demo/